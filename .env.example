# --- Email (required in production) ---------------------------------------
# Create a free account at https://resend.com and an API key.
RESEND_API_KEY=
# Where booking notifications are sent.
BOOKING_EMAIL_TO=paramountlaundry0@gmail.com
# Sender. "onboarding@resend.dev" works without a domain, but Resend only
# delivers it to the email you signed up with — so sign up to Resend using
# paramountlaundry0@gmail.com, or verify your own domain and use e.g.
# "Paramount Laundry <bookings@yourdomain.com>".
BOOKING_EMAIL_FROM=Paramount Laundry <onboarding@resend.dev>

# --- Booked-slot storage (required in production) ------------------------
# Add the "Upstash for Redis" integration in Vercel (Storage tab). It sets
# KV_REST_API_URL / KV_REST_API_TOKEN automatically. Either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
